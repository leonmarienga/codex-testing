generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String
  priceCents  Int
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tags        ProductTag[]
}

model Tag {
  id          String            @id @default(cuid())
  key         String            @unique
  label       String
  productTags ProductTag[]
  optionScores QuizOptionScore[]
}

model ProductTag {
  productId String
  tagId     String
  weight    Int     @default(1)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model QuizQuestion {
  id       String       @id @default(cuid())
  key      String       @unique
  prompt   String
  type     String
  sortOrder Int
  options  QuizOption[]
}

model QuizOption {
  id         String            @id @default(cuid())
  questionId String
  value      String
  label      String
  sortOrder  Int
  question   QuizQuestion      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  scores     QuizOptionScore[]

  @@unique([questionId, value])
}

model QuizOptionScore {
  optionId String
  tagId    String
  score    Int
  option   QuizOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  tag      Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([optionId, tagId])
}

model QuizSession {
  id           String       @id @default(cuid())
  emailCapture String?
  createdAt    DateTime     @default(now())
  answers      QuizAnswer[]
}

model QuizAnswer {
  id          String      @id @default(cuid())
  sessionId   String
  session     QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionKey String
  optionValue String
}
